<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Container.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="60dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_time"
                style="@style/Text.Heading3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="08:00"
                android:textColor="@color/primary_500" />

            <TextView
                android:id="@+id/tv_period"
                style="@style/Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="AM" />
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:background="@color/divider" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_task_title"
                style="@style/Text.BodyPrimary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                tools:text="Họp Team Marketing"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_task_location"
                style="@style/Text.BodySecondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                tools:text="Phòng họp số 2 • Tòa nhà AI" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>