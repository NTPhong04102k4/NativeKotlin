<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base Text Styles -->
    <style name="Text" parent="android:Widget.TextView">
        <item name="android:ellipsize">end</item>
        <item name="android:maxLines">10</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Text.Heading1">
        <item name="android:textSize">32sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Text.Heading2">
        <item name="android:textSize">26sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Text.Heading3">
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Text.BodyPrimary">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="Text.BodySecondary">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="Text.Caption">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_disabled</item>
    </style>

    <!-- M3 Button Styles -->
    <style name="Button.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/primary_500</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="shapeAppearance">@style/ShapeAppearance.App.Card</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">56dp</item>
    </style>

    <style name="Button.Social" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textColor">@color/text_primary</item>
        <item name="strokeColor">@color/divider</item>
        <item name="strokeWidth">1dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.App.Card</item>
        <item name="android:minHeight">56dp</item>
        <item name="iconPadding">12dp</item>
    </style>

    <style name="Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textColor">@color/primary_500</item>
        <item name="strokeColor">@color/primary_500</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.App.Card</item>
        <item name="android:minHeight">56dp</item>
    </style>

    <!-- M3 Input Styles -->
    <style name="InputField" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/primary_500</item>
        <item name="hintTextColor">@color/primary_500</item>
        <item name="android:textColorHint">@color/text_secondary</item>
        <item name="shapeAppearance">@style/ShapeAppearance.App.Input</item>
        <item name="boxStrokeWidth">1.5dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
    </style>

    <!-- M3 Container Styles -->
    <style name="Container.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/background_primary</item>
        <item name="cardElevation">0dp</item>
        <item name="android:layout_margin">0dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.App.Card</item>
        <item name="strokeColor">@color/divider</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="ListItem">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">64dp</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <!-- M3 Shapes -->
    <style name="ShapeAppearance.App.Input" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerSize">@dimen/input_corner_radius</item>
    </style>

    <style name="ShapeAppearance.App.Card" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerSize">@dimen/card_corner_radius</item>
    </style>

</resources>